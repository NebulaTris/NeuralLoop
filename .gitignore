# dependencies and builds
node_modules/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/

# generated books and media: never commit someone's book
neuralloop-*/
poc_out/
neuralloop_media/
*.m4a
*.mp4
*.mp3
*.caf
*.pdf
*.epub
# …except the sample books (the dry run and the tests use them) and Silly mode's own nudge sounds (NOTICE.md)
!pipeline/sample/**
!pipeline/tests/sample/**
!apple/App/Resources/NeuralLoop-*.caf

.DS_Store

# editor settings
.idea/

# built runtimes and packaging leftovers
build/
apple/.build/
apple/Config/Google.xcconfig
apple/NeuralLoop.xcodeproj/
apple/build/
dist/

# never commit secrets or generated audio
.env
.env.*
*.p12
*.key
*.mobileprovision
*.wav

# your own signing team and private maintainer notes (never public)
apple/Config/Local.xcconfig
docs/private/
.claude/worktrees/
