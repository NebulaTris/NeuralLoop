{
  "name": "neuralloop-study-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/main.js --bundle --format=iife --target=es2020 --outfile=app.js --legal-comments=none",
    "test": "node --test test/*.test.mjs",
    "format": "prettier --write src test",
    "check": "prettier --check src test && npm test && npm run build"
  },
  "devDependencies": {
    "d3": "^7.9.0",
    "esbuild": "^0.24.0",
    "prettier": "^3.3.0"
  },
  "prettier": {
    "printWidth": 120
  }
}
