{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeuralLoop Books",
  "version": "0.1.0",
  "identifier": "app.neuralloop.books",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NeuralLoop Books",
        "width": 1320,
        "height": 860,
        "minWidth": 420,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; frame-src nlbook: http://nlbook.localhost; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "A whole book in, a cute learning loop out",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../pipeline/nl_book.py": "pipeline/nl_book.py",
      "../pipeline/neuralloop_books/": "pipeline/neuralloop_books/",
      "../pipeline/site/index.html": "pipeline/site/index.html",
      "../pipeline/site/styles.css": "pipeline/site/styles.css",
      "../pipeline/site/app.js": "pipeline/site/app.js",
      "../pipeline/site/pip-poses.js": "pipeline/site/pip-poses.js",
      "../pipeline/sample/sample-book.epub": "pipeline/sample/sample-book.epub"
    }
  }
}